+!*  9.2          passive test tracer, as the momentum above but without the pressure-gradient
+!                term: values in the updraft and downdraft from entrainment and detrainment
+!                only, then the same flux form (cududvn)
+!-------------------------------------------------------------------
+      do jk = 1 , klev
+        do jl = 1, klon
+          zcen(jl,jk) = exp(-pgeo(jl,jk)/(g*3000.))
+          zcu(jl,jk) = zcen(jl,jk)
+          zcd(jl,jk) = zcen(jl,jk)
+          zcdum(jl,jk) = 0.
+        end do
+      end do
+      do jk = klev-1 , 2 , -1
+        ik = jk + 1
+        do jl = 1,klon
+          if ( ldcum(jl) ) then
+            if ( jk == kcbot(jl) .and. ktype(jl) < 3 ) then
+              ikb = kdpl(jl)
+              zcu(jl,jk) = zcen(jl,ikb-1)
+            else if ( jk == kcbot(jl) .and. ktype(jl) == 3 ) then
+              zcu(jl,jk) = zcen(jl,jk-1)
+            end if
+            if ( jk < kcbot(jl) .and. jk >= kctop(jl) ) then
+              zerate = pmfu(jl,jk) - pmfu(jl,ik) + pmfude_rate(jl,jk)
+              zderate = pmfude_rate(jl,jk)
+              zmfa = 1./max(cmfcmin,pmfu(jl,jk))
+              zcu(jl,jk) = (zcu(jl,ik)*pmfu(jl,ik) + &
+                zerate*zcen(jl,jk)-zderate*zcu(jl,ik))*zmfa
+            end if
+          end if
+        end do
+      end do
+      if(lmfdd) then
+      do jk = 3 , klev
+        ik = jk - 1
+        do jl = 1,klon
+          if ( ldcum(jl) ) then
+            if ( jk == idtop(jl) ) then
+              zcd(jl,jk) = 0.5*(zcu(jl,jk)+zcen(jl,ik))
+            else if ( jk > idtop(jl) ) then
+              zerate = -pmfd(jl,jk) + pmfd(jl,ik) + pmfdde_rate(jl,jk)
+              zmfa = 1./min(-cmfcmin,pmfd(jl,jk))
+              zcd(jl,jk) = (zcd(jl,ik)*pmfd(jl,ik) - &
+                zerate*zcen(jl,ik)+pmfdde_rate(jl,jk)*zcd(jl,ik))*zmfa
+            end if
+          end if
+        end do
